Server health information","allOf":[{"$ref":"#/components/schemas/HealthDto"}]}},"required":["success","message","version","timestamp","responseTime","health"]},"LoginDto":{"type":"object","properties":{"email":{"type":"string","example":"john.doe@example.com"},"password":{"type":"string","example":"fhgtytye@r4d12"}},"required":["email","password"]},"ActivateAccountDto":{"type":"object","properties":{"otpType":{"type":"string","enum":["SIGN_UP","CHANGE_PASSWORD","FORGOT_PASSWORD","ADMIN_LOGIN"]},"otp":{"type":"string","description":"OTP code sent to the user","example":"123456"},"email":{"type":"string"}},"required":["otpType","otp","email"]},"CreateAdminDto":{"type":"object","properties":{"firstName":{"type":"string","example":"John"},"lastName":{"type":"string","example":"Doe"},"email":{"type":"string","example":"john.doe@example.com"},"countryCode":{"type":"string","example":"+234"},"phoneNumber":{"type":"string","example":"9069699734"},"roleId":{"type":"string","example":"w12234237863878hhjeg653622"}},"required":["firstName","lastName","email","countryCode","phoneNumber","roleId"]},"SendPasswordOtpDto":{"type":"object","properties":{"email":{"type":"string"}},"required":["email"]},"ResendOTPDto":{"type":"object","properties":{"otpType":{"type":"string","enum":["SIGN_UP","CHANGE_PASSWORD","FORGOT_PASSWORD","ADMIN_LOGIN"]},"email":{"type":"string"}},"required":["otpType","email"]},"ResetPasswordDto":{"type":"object","properties":{"password":{"type":"string"},"email":{"type":"string"}},"required":["password","email"]},"UpdateAdminRoleDto":{"type":"object","properties":{"roleId":{"type":"Role Id"}},"required":["roleId"]},"CreateRoleDto":{"type":"object","properties":{"name":{"type":"string"},"description":{"type":"string"},"permissionIds":{"type":"array","items":{"type":"string"}}},"required":["name","description","permissionIds"]},"UpdateRoleDto":{"type":"object","properties":{"name":{"type":"string"},"description":{"type":"string"},"permissionIds":{"type":"array","items":{"type":"string"}}},"required":["name","description","permissionIds"]},"CreateMenuDto":{"type":"object","properties":{"name":{"type":"string","description":"Menu name"},"url":{"type":"string","description":"Menu url"},"icon":{"type":"string","description":"Menu icon name"},"order":{"type":"number","description":"Menu order"},"parentId":{"type":"string","description":"Menu parent Id"},"permissions":{"description":"Menu Permissions","type":"array","items":{"type":"string"}}},"required":["name","url","icon","order","parentId","permissions"]},"CreateEstateDto":{"type":"object","properties":{"estateName":{"type":"string","example":"Estate Name"},"firstName":{"type":"string","example":"John"},"lastName":{"type":"string","example":"Doe"},"cac":{"type":"string","example":"CAC number"},"countryCode":{"type":"string","example":"countryCode"},"phoneNumber":{"type":"string","example":"Phone number"},"email":{"type":"string","example":"john.doe@example.com"},"address":{"type":"string","example":"Address"},"city":{"type":"string","example":"City"},"state":{"type":"string","example":"State"},"country":{"type":"string","example":"Country"}},"required":["estateName","firstName","lastName","cac","countryCode","phoneNumber","email","address","city","state","country"]},"EditEstateDto":{"type":"object","properties":{"estateName":{"type":"string","example":"Estate Name"},"cac":{"type":"string","example":"CAC number"},"address":{"type":"string","example":"Address"},"lga":{"type":"string","example":"Local government area"},"city":{"type":"string","example":"City"},"state":{"type":"string","example":"State"},"country":{"type":"string","example":"Country"}},"required":["estateName","cac","address","lga","city","state","country"]},"CreateEstateAdminDto":{"type":"object","properties":{"firstName":{"type":"string","example":"John"},"lastName":{"type":"string","example":"Doe"},"email":{"type":"string","example":"john.doe@example.com"},"roleId":{"type":"string","example":"w12234237863878h